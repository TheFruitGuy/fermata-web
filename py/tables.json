  "METHODS": {
    "dualdtw": [
      "Dual DTW",
      "parangonar's DualDTWNoteMatcher: aligns the onsets first, then the notes. Copes well with extra and missing notes."
    ],
    "automatic": [
      "Automatic",
      "parangonar's AutomaticNoteMatcher: time warping over the passage, then note matching."
    ],
    "outerhmm": [
      "Outer HMM",
      "parangonar's SwitchingOuterHMMMatcher, for rehearsals: follows the performance through the whole score, with skips, repeats and new starts anywhere. A new alignment gets the sections it finds."
    ],
    "anchors": [
      "Anchor points",
      "parangonar's AnchorPointNoteMatcher, guided by your anchors and by the links just before and after the passage."
    ]
  },
  "DEFAULT_METHOD": "dualdtw",
  "TIMING": "Aligning takes about 10 seconds for 2,000 notes with Dual DTW and half a minute with Automatic. A long piece can take a few minutes. Outer HMM is for rehearsals: it follows their jumps and repeats, and finds their sections.",
